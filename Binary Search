#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int A[n];

    // Read sorted array
    for (int i = 0; i < n; i++) {
        cin >> A[i];
    }

    int key;
    cin >> key;

    int low = 0;
    int high = n - 1;

    while (low <= high) {
        int mid = (low + high) / 2;

        if (A[mid] == key) {
            cout << "Element found at position " << mid + 1;
            return 0;
        }
        else if (A[mid] < key) {
            low = mid + 1;
        }
        else {
            high = mid - 1;
        }
    }

    cout << "Element not found";

    return 0;
}
